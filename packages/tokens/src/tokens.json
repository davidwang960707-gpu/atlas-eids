{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "meta": {
    "name": "Atlas EIDS",
    "version": "0.2.0-beta.1"
  },
  "global": {
    "color.brand.primary": "#7B61FF",
    "color.brand.strong": "#4F46E5",
    "color.brand.soft": "#B7A7FF",
    "color.accent.cyan": "#06B6D4",
    "color.accent.green": "#00C48C",
    "color.accent.amber": "#F59E0B",
    "color.accent.rose": "#EF5DA8",
    "space.1": "4px",
    "space.2": "8px",
    "space.3": "12px",
    "space.4": "16px",
    "space.5": "20px",
    "space.6": "24px",
    "space.8": "32px",
    "space.12": "48px",
    "radius.control": "6px",
    "radius.panel": "8px",
    "radius.overlay": "10px",
    "radius.round": "9999px",
    "control.height.compact": "28px",
    "control.height.default": "32px",
    "control.height.comfortable": "40px",
    "font.family.sans": "Inter, PingFang SC, Microsoft YaHei, sans-serif",
    "font.family.mono": "JetBrains Mono, SFMono-Regular, Consolas, monospace",
    "font.size.caption": "12px",
    "font.size.body": "14px",
    "font.size.title": "20px",
    "font.weight.regular": "400",
    "font.weight.medium": "500",
    "font.weight.semibold": "600",
    "line.height.body": "1.5",
    "motion.fast": "150ms cubic-bezier(0.22, 1, 0.36, 1)",
    "motion.base": "240ms cubic-bezier(0.22, 1, 0.36, 1)",
    "motion.living": "1800ms cubic-bezier(0.37, 0, 0.63, 1)",
    "z.dropdown": "1000",
    "z.overlay": "1100",
    "z.toast": "1200"
  },
  "themes": {
    "light": {
      "color.bg.canvas": "#F5F7FA",
      "color.bg.surface": "#FFFFFF",
      "color.bg.subtle": "#F3F5F8",
      "color.bg.elevated": "#FFFFFF",
      "color.text.primary": "#1D2129",
      "color.text.secondary": "#4E5969",
      "color.text.tertiary": "#5F6B7A",
      "color.text.inverse": "#FFFFFF",
      "color.border.default": "#E5E8EF",
      "color.border.strong": "#C9CDD4",
      "color.action.primary": "#4F46E5",
      "color.action.primaryHover": "#4338CA",
      "color.action.soft": "#F0ECFF",
      "color.status.success": "#087443",
      "color.status.warning": "#8A4B00",
      "color.status.error": "#C43C35",
      "color.status.info": "#2F80ED",
      "shadow.overlay": "0 12px 32px rgba(29, 33, 41, 0.14)",
      "shadow.orb": "0 0 28px rgba(123, 97, 255, 0.34)"
    },
    "dark": {
      "color.bg.canvas": "#101116",
      "color.bg.surface": "#171920",
      "color.bg.subtle": "#1E2029",
      "color.bg.elevated": "#232630",
      "color.text.primary": "#F2F3F5",
      "color.text.secondary": "#C9CDD4",
      "color.text.tertiary": "#86909C",
      "color.text.inverse": "#171920",
      "color.border.default": "#2F333D",
      "color.border.strong": "#4E5969",
      "color.action.primary": "#8D75FF",
      "color.action.primaryHover": "#A08CFF",
      "color.action.soft": "#292441",
      "color.status.success": "#23C98B",
      "color.status.warning": "#F2A93B",
      "color.status.error": "#F06A63",
      "color.status.info": "#6AA8FF",
      "shadow.overlay": "0 16px 40px rgba(0, 0, 0, 0.38)",
      "shadow.orb": "0 0 34px rgba(123, 97, 255, 0.48)"
    }
  }
}
