{
  "realm": "atlas-eids",
  "enabled": true,
  "sslRequired": "none",
  "displayName": "Atlas EIDS",
  "accessTokenLifespan": 300,
  "roles": {
    "realm": [
      { "name": "ADMIN" },
      { "name": "USER" }
    ]
  },
  "clients": [
    {
      "clientId": "atlas-cli",
      "name": "Atlas EIDS CLI",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:*/*", "http://127.0.0.1:*/*"],
      "webOrigins": ["+"]
    }
  ],
  "clientScopes": [
    {
      "name": "atlas-claims",
      "protocol": "openid-connect",
      "attributes": { "include.in.token.scope": "true" },
      "protocolMappers": [
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        },
        {
          "name": "tenants",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "tenants",
            "claim.name": "tenants",
            "jsonType.label": "String",
            "multivalued": "true",
            "access.token.claim": "true",
            "id.token.claim": "true"
          }
        }
      ]
    }
  ],
  "defaultDefaultClientScopes": ["profile", "email", "roles", "atlas-claims"],
  "users": [
    {
      "username": "admin",
      "enabled": true,
      "firstName": "Atlas",
      "lastName": "Admin",
      "email": "admin@atlas.local",
      "emailVerified": true,
      "requiredActions": [],
      "attributes": { "tenants": ["atlas-cn", "east-retail", "south-sales"] },
      "credentials": [{ "type": "password", "value": "atlas-local-only", "temporary": false }],
      "realmRoles": ["ADMIN", "USER"]
    },
    {
      "username": "analyst",
      "enabled": true,
      "firstName": "Atlas",
      "lastName": "Analyst",
      "email": "analyst@atlas.local",
      "emailVerified": true,
      "requiredActions": [],
      "attributes": { "tenants": ["atlas-cn"] },
      "credentials": [{ "type": "password", "value": "atlas-local-only", "temporary": false }],
      "realmRoles": ["USER"]
    }
  ]
}
